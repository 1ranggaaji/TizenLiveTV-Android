<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme for Samsung Tizen Live TV -->
    <style name="Theme.TizenLiveTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/tizen_bg_black</item>
        <item name="android:colorBackground">@color/tizen_bg_black</item>
        <item name="colorPrimary">@color/tizen_neon_blue</item>
        <item name="colorAccent">@color/tizen_neon_cyan</item>
        <item name="android:textColorPrimary">@color/tizen_text_primary</item>
        <item name="android:textColorSecondary">@color/tizen_text_secondary</item>
        <item name="android:windowOverscan">true</item>
    </style>
</resources>
