<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tizen_card_focused"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:text="TAMBAH PLAYLIST IPTV (M3U / M3U8)"
        android:textColor="@color/tizen_neon_cyan"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:text="Tempel URL playlist M3U/M3U8 siaran TV lokal atau internasional untuk ditambahkan ke daftar saluran:"
        android:textColor="@color/tizen_text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_m3u_url"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tizen_pill_default"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:hint="https://example.com/iptv_indonesia.m3u"
        android:paddingHorizontal="16dp"
        android:textColor="@color/tizen_text_primary"
        android:textColorHint="@color/tizen_text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_m3u_cancel"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:background="@drawable/selector_tizen_pill"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_cancel"
            android:textColor="@color/tizen_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_m3u_save"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_tizen_pill_focused"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:text="Muat Saluran"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
