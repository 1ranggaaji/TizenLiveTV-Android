<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/epg_program_root"
    android:layout_width="220dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="12dp"
    android:background="@drawable/selector_tizen_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_program_slot_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="20:00 - 21:30"
        android:textColor="@color/tizen_neon_cyan"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_program_live_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_live_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="LIVE"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_program_slot_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="Premier League Matchday"
        android:textColor="@color/tizen_text_primary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_program_slot_time" />

    <TextView
        android:id="@+id/tv_program_slot_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="90 Menit • Olahraga"
        android:textColor="@color/tizen_text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/pb_program_slot_progress"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/pb_program_slot_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginBottom="2dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/progress_tizen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
