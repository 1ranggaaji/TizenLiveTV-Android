<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/epg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2070A0F"
    android:padding="32dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Top Header -->
    <TextView
        android:id="@+id/tv_epg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:text="PANDUAN TV (EPG) • SAMSUNG SMART HUB"
        android:textColor="@color/tizen_neon_cyan"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_epg_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Minggu, 20:30 WIB"
        android:textColor="@color/tizen_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Category Tabs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_epg_categories"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_epg_title" />

    <!-- Center Content: Channels & Timeline -->
    <LinearLayout
        android:id="@+id/layout_epg_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/card_epg_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_epg_categories">

        <!-- Channels Vertical List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_epg_channels"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tizen_card"
            android:padding="8dp" />

        <!-- Programs Timeline List for Selected Channel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_epg_timeline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tizen_card"
            android:orientation="horizontal"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Bottom Selected Program Details Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_epg_details"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_tizen_card_focused"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Judul Acara Televisi"
            android:textColor="@color/tizen_text_primary"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@id/btn_epg_watch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_detail_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="20:00 - 22:00 (120 Menit) • Hiburan • PG-13"
            android:textColor="@color/tizen_neon_cyan"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />

        <TextView
            android:id="@+id/tv_detail_desc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="Deskripsi lengkap dari program tayangan televisi dengan resolusi 4K dan kualitas audio surround sound terbaik untuk tontonan keluarga."
            android:textColor="@color/tizen_text_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_epg_watch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_time" />

        <Button
            android:id="@+id/btn_epg_watch"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tizen_pill_focused"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_watch_now"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
